```gitignore
# Dependencies
node_modules/

# Build files
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files
pids/
*.pid
*.seed
*.pid.lock

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# TypeScript
*.tsbuildinfo

# Cache
.cache/
.parcel-cache/

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/

# Package manager lock files (optional)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Prisma
prisma/dev.db
prisma/dev.db-journal

# Uploads
uploads/
public/uploads/

# Docker
.dockerignore

# Testing
.nyc_output/

# Misc
*.tgz
```
